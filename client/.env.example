# Em dev usa o proxy do Vite (/api -> :3001). Em prod o Express serve o dist/.
# Só preencher em build standalone apontando para outra origem.
VITE_API_URL=

# Destino do formulário público de demonstração. O front abre o cliente de e-mail.
VITE_COMERCIAL_EMAIL=comercial@olumechat.com.br

# Domínio de produção exibido no formulário de provisionamento do operador
# (client/src/pages/operador/Operador.jsx). Sem valor, cai no default abaixo.
VITE_APP_DOMAIN=olumechat.com.br

# === Observabilidade (públicas, embutidas no bundle pelo Vite) ===
# Sem valor, Sentry e PostHog ficam desligados. Não coloque segredo aqui.
# DSN do projeto Sentry olumechat-web. No Coolify/CI entra como build-arg.
# VITE_SENTRY_DSN=
# producao | homologacao | dev. A imagem de staging da CI usa homologacao.
# VITE_SENTRY_ENVIRONMENT=
# Chave de projeto do PostHog (não é segredo de API pessoal). Só envia evento
# com alguém logado, e o identify usa só o id interno.
# VITE_POSTHOG_KEY=
# Host do projeto. Vazio usa https://eu.i.posthog.com.
# VITE_POSTHOG_HOST=
