# Em dev usa o proxy do Vite (/api -> :3001). Em prod o Express serve o dist/.
# Só preencher em build standalone apontando para outra origem.
VITE_API_URL=

# Destino do formulário público de demonstração. O front abre o cliente de e-mail.
VITE_COMERCIAL_EMAIL=comercial@olumechat.com.br

# Domínio de produção exibido no formulário de provisionamento do operador
# (client/src/pages/operador/Operador.jsx). Sem valor, cai no default abaixo.
VITE_APP_DOMAIN=olumechat.com.br
