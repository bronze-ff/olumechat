# .env.example — Falatta
# Copie para .env e preencha. NUNCA commitar o .env real.

# === Servidor ===
PORT=3001
NODE_ENV=production

# === Meta / WhatsApp Cloud API ===
# ID do aplicativo — necessário para o Embedded Signup.
META_APP_ID=

# Chave Secreta do Aplicativo (App Secret) — usada para validar a assinatura do webhook.
# Meta for Developers > App > Configurações > Básico > Chave Secreta do App.
META_APP_SECRET=

# Token de verificação do webhook — string aleatória que VOCÊ inventa.
# Precisa ser idêntica à cadastrada no painel da Meta (passo do webhook).
# Vale tanto para /webhook quanto para /webhook/<identificador> (FIL-97).
# Gerar: openssl rand -hex 16
WEBHOOK_VERIFY_TOKEN=

# === App da Meta POR CLIENTE (FIL-97) — OPCIONAIS ===
# Enquanto a Olume não tem CNPJ (logo, nenhum app verificado próprio), cada
# cliente conecta o app DELE: App ID, App Secret e token permanente ficam
# cifrados por tenant em `meta_conexao`, e cada cliente recebe uma URL de
# webhook exclusiva (`/webhook/<32 hex>`). Nada disso é variável de ambiente —
# o operador cadastra na sessão de suporte. O que existe aqui é só o endereço
# público usado para MOSTRAR essa URL na tela.
#
# Base pública desta API. Sem ela, a URL é deduzida do header Host da
# requisição — defina nos ambientes hospedados, porque o valor exibido vai ser
# colado numa configuração da Meta e um endereço errado só aparece depois, como
# "o webhook nunca chega".
# WEBHOOK_BASE_URL=https://api.olumechat.com.br
# Teto de respostas 4xx por IP em 15 min no webhook por caminho (anti-varredura;
# tráfego legítimo responde 200 e nunca é contado). Default: 120.
# WEBHOOK_CAMINHO_RATE_LIMIT_MAX=120

# Fallback SOMENTE para desenvolvimento local legado. Em produção, as
# credenciais são armazenadas cifradas por tenant após o onboarding.
DEV_META_FALLBACK=0
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=

# Versão da Graph API (mantenha atualizada conforme a Meta).
GRAPH_VERSION=v21.0

# === Entrada durável do webhook (FIL-94) — todos OPCIONAIS ===
# O evento bruto da Meta é gravado ANTES do ACK e reprocessado se o processo
# morrer no meio (server/webhook/durabilidade.js). Os defaults servem produção;
# mexa só com motivo.
# Cadência da varredura de recuperação (ms).
# WEBHOOK_RECUPERACAO_INTERVALO_MS=60000
# Minutos sem terminar até um evento ser considerado abandonado. NÃO use 0: em
# rolling update a instância antiga ainda está processando eventos legítimos.
# WEBHOOK_ORFAO_MIN=2
# Tentativas antes de marcar falha DEFINITIVA (a linha fica no banco com o erro).
# WEBHOOK_MAX_TENTATIVAS=5
# Eventos reprocessados por passada.
# WEBHOOK_RECUPERACAO_LOTE=50
# Retenção do payload bruto (dias). Só apaga evento já concluído — o payload
# contém mensagem de cliente (LGPD), então não fica para sempre.
# WEBHOOK_RETENCAO_DIAS=7
# Acima deste atraso de processamento (ms) o log emite aviso (base do alerta).
# WEBHOOK_ATRASO_ALERTA_MS=60000

# Diretório onde os arquivos recebidos (mídia) serão gravados.
# Aponte para o servidor de arquivos Windows (caminho local ou UNC).
# Ex.: \\SERVIDOR-ARQ\mc-zap\midia  ou  D:\mc-zap\midia
MEDIA_DIR=

# === Auth (inbox) ===
# Se vazio, o sistema GERA um segredo forte (crypto) e grava aqui no 1º boot.
# Para forçar um novo (invalidando sessões): apague esta linha e reinicie.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Validade (minutos) do link de definição de senha do primeiro acesso.
# Default: 4320 (3 dias). Ver server/auth/tokenSenha.js.
SENHA_TOKEN_TTL_MIN=4320

# === Painel do operador (FIL-70) ===
# ⚠️ Segredo do JWT do OPERADOR — tem que ser DIFERENTE do JWT_SECRET acima.
# É o que impede um token do painel do cliente de valer no painel do operador
# (e vice-versa). Se vazio, o sistema gera um forte e grava aqui no 1º boot em
# produção. Gerar à mão: openssl rand -hex 48
OPERADOR_JWT_SECRET=
# Sessão curta de propósito — é a credencial mais poderosa do sistema.
OPERADOR_JWT_EXPIRES_IN=2h
# Validade (minutos) da sessão de SUPORTE dentro de um tenant (somente-leitura,
# registrada na auditoria que o cliente enxerga). Default: 30.
OPERADOR_SUPORTE_TTL_MIN=30

# URL pública do painel — usada para montar o link do convite de senha que o
# provisionamento devolve ao operador (não há envio de e-mail ainda).
APP_URL=https://olumechat.com.br
# Origens adicionais exatas, separadas por vírgula. APP_URL já é permitida.
# CORS_ORIGINS=https://www.olumechat.com.br

# === PostgreSQL (Neon) ===
# Connection string POOLED do Neon (o host tem "-pooler"). O pooler roda
# PgBouncer em transaction mode — por isso o contexto de tenant é setado com
# set_config(..., true), transaction-scoped. Ver server/db/pool.js.
DATABASE_URL=postgresql://usuario:senha@ep-xxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require
# Conexão DIRETA (sem "-pooler"), obrigatória para LISTEN/NOTIFY do SSE.
DATABASE_URL_DIRECT=postgresql://usuario:senha@ep-xxx.REGIAO.aws.neon.tech/neondb?sslmode=require
# Connection string DIRECTA da branch de producao do Neon, sem "-pooler".
# O deploy aplica as migracoes com esta URL antes de iniciar o servidor.
MIGRATION_DATABASE_URL=postgresql://usuario:senha@ep-xxx.REGIAO.aws.neon.tech/neondb?sslmode=require
# Opcional — teto de conexões do pool da instância (default 10).
DB_POOL_MAX=10
# Opcional — connection string DIRETA (sem "-pooler"), usada para aplicar
# migrações e por testes de integração de RLS. Sem ela, esses testes são
# pulados localmente (a suíte continua verde). Na CI ela é obrigatória: o job
# server-test-rls a define e RLS_OBRIGATORIO=1 transforma teste pulado em falha.
# TEST_DATABASE_URL=

# === Deploy (Render) ===
# Render injeta PORT e NODE_ENV; os segredos sao cadastrados no painel,
# nunca neste arquivo. Para desenvolvimento descartavel, use a branch Neon
# separada e informe a URL direta dela em MIGRATION_DATABASE_URL.

# === Pulso (telemetria/licença — opcional) ===
# Sem estas variáveis, a telemetria fica DESLIGADA e o app roda normal.
# Endpoint base das Edge Functions do Pulso (Supabase) e a licença desta instância.
PULSO_URL=
PULSO_KEY=
PULSO_SECRET=
# anon/publishable key do Supabase (Settings → API) — passa pelo "Verify JWT" das Edge Functions.
# Só precisa se você NÃO desligar o "Verify JWT" das functions. É chave pública (pode ficar no .env).
PULSO_ANON_KEY=
# Opcionais: pasta p/ persistir o id da instância (default: cwd) e cadência do heartbeat.
PULSO_DATA_DIR=
PULSO_INTERVALO_MS=60000

# === Bot de IA (opcional) ===
# Chave ESTÁVEL que cifra credenciais de IA e tokens Meta por tenant.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IA_CRYPTO_KEY=

# Pasta com o conhecimento do bot (queries/*.sql + system-prompt.md).
# O instalador já copia uma versão inicial para cá (bootstrap); o painel
# "Atualizar conhecimento" baixa a versão mais recente do repo mc-OS (GitHub)
# nesta mesma pasta, sem precisar reinstalar.
# CONHECIMENTO_DIR=  # default: ./conhecimento
# Repositório GitHub de onde vem o conhecimento (mc-OS = multicanalOS).
# GITHUB_OWNER=MulticanalAtacado
# GITHUB_REPO=mc-OS
# GITHUB_REF=main
# Token read-only (fine-grained, escopo Contents:Read) — obrigatório apenas
# se o repo mc-OS for privado. NUNCA commitar um token real aqui.
# GITHUB_TOKEN=
# Mídia: use local somente em desenvolvimento; em produção use s3/R2.
STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_SIGNING_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
