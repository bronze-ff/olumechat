# .env.example — MC-Zap Fase 0
# Copie para .env e preencha. NUNCA commitar o .env real.

# === Servidor ===
PORT=3001
NODE_ENV=production

# === Meta / WhatsApp Cloud API ===
# Chave Secreta do Aplicativo (App Secret) — usada para validar a assinatura do webhook.
# Meta for Developers > App > Configurações > Básico > Chave Secreta do App.
META_APP_SECRET=

# Token de verificação do webhook — string aleatória que VOCÊ inventa.
# Precisa ser idêntica à cadastrada no painel da Meta (passo do webhook).
# Gerar: openssl rand -hex 16
WEBHOOK_VERIFY_TOKEN=

# System User token PERMANENTE (não o token de 24h do dashboard).
# Permissões: whatsapp_business_messaging + whatsapp_business_management.
WA_TOKEN=

# Phone Number ID (NÃO é o número de telefone) — obtido após registrar o número na WABA.
WA_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA ID).
WA_BUSINESS_ACCOUNT_ID=

# Versão da Graph API (mantenha atualizada conforme a Meta).
GRAPH_VERSION=v21.0

# Diretório onde os arquivos recebidos (mídia) serão gravados.
# Aponte para o servidor de arquivos Windows (caminho local ou UNC).
# Ex.: \\SERVIDOR-ARQ\mc-zap\midia  ou  D:\mc-zap\midia
MEDIA_DIR=

# === Auth (inbox) ===
# Se vazio, o sistema GERA um segredo forte (crypto) e grava aqui no 1º boot.
# Para forçar um novo (invalidando sessões): apague esta linha e reinicie.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Matrículas com flag de diretor (separadas por vírgula)
DIRETORES_MATRICULAS=

# === Oracle (schema dedicado MCLABS) ===
# O backend conecta como MCLABS (dono das tabelas MC_ZAP_*).
# Criar o schema com scripts/00_create_schema.sql (rodar como DBA).
# Login (MC_SENHAS) exige: GRANT SELECT ON MCCANAL.MC_SENHAS TO MCLABS.
ORACLE_USER=MCLABS
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=HOST:1521/SERVICO
# Opcional — caminho do Instant Client (se não estiver no PATH do sistema).
ORACLE_LIB_DIR=

# === Pulso (telemetria/licença — opcional) ===
# Sem estas variáveis, a telemetria fica DESLIGADA e o app roda normal.
# Endpoint base das Edge Functions do Pulso (Supabase) e a licença desta instância.
PULSO_URL=
PULSO_KEY=
PULSO_SECRET=
# anon/publishable key do Supabase (Settings → API) — passa pelo "Verify JWT" das Edge Functions.
# Só precisa se você NÃO desligar o "Verify JWT" das functions. É chave pública (pode ficar no .env).
PULSO_ANON_KEY=
# Opcionais: pasta p/ persistir o id da instância (default: cwd) e cadência do heartbeat.
PULSO_DATA_DIR=
PULSO_INTERVALO_MS=60000

# === Bot de IA (opcional) ===
# Pasta com o conhecimento do bot (queries/*.sql + system-prompt.md).
# O instalador já copia uma versão inicial para cá (bootstrap); o painel
# "Atualizar conhecimento" baixa a versão mais recente do repo mc-OS (GitHub)
# nesta mesma pasta, sem precisar reinstalar.
# CONHECIMENTO_DIR=  # default: ./conhecimento
# Repositório GitHub de onde vem o conhecimento (mc-OS = multicanalOS).
# GITHUB_OWNER=MulticanalAtacado
# GITHUB_REPO=mc-OS
# GITHUB_REF=main
# Token read-only (fine-grained, escopo Contents:Read) — obrigatório apenas
# se o repo mc-OS for privado. NUNCA commitar um token real aqui.
# GITHUB_TOKEN=
