{
  "name": "olume-chat-server",
  "version": "0.1.0",
  "description": "Olume Chat — plataforma multi-tenant de atendimento por WhatsApp (Cloud API)",
  "main": "app.js",
  "scripts": {
    "start": "node --import ./observabilidade/instrument.mjs app.js",
    "dev": "nodemon --exec \"node --import ./observabilidade/instrument.mjs\" app.js",
    "test": "node test/run-tests.js",
    "verify": "npm test",
    "test-send": "node scripts/testSend.js",
    "migrar": "node scripts/migrar.js",
    "criar-operador": "node scripts/criar-operador.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/node": "^11.9.0",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "proxy-addr": "2.0.8",
    "uuid": "11.1.1"
  }
}
