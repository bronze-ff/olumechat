node_modules/
.env
.env.local
server/.env
client/.env
*.log
logs/
media/
server/media/
client/dist/
# FIL-113: marcador de versão gravado DENTRO da imagem em tempo de build
# (Dockerfile). Se aparecer aqui na árvore de trabalho é build local — versionar
# faria o dev servir uma versão fixa e mentirosa em /health/*.
BUILD_SHA

# Config local do agente / skills pessoais
.claude/*
# skills sao conhecimento do projeto, nao configuracao pessoal — versionadas
# só a skill própria do projeto; as de marketplace (neon, copywriting,
# senior-security) são instaláveis e ficam de fora para não apodrecerem aqui
!.claude/skills/
.claude/skills/*
!.claude/skills/orquestrar-projeto/
.claude/settings.local.json
.claude/launch.json
.claude/scheduled_tasks.lock
.superpowers/

.DS_Store
.agents/
tmp/
