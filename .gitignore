node_modules/
.env
.env.local
server/.env
client/.env
*.log
logs/
media/
server/media/
client/dist/
# FIL-113: marcador de versão gravado DENTRO da imagem em tempo de build
# (Dockerfile). Se aparecer aqui na árvore de trabalho é build local — versionar
# faria o dev servir uma versão fixa e mentirosa em /health/*.
BUILD_SHA

# Config local do agente. Skills compartilhadas são instaladas globalmente em
# ~/.agents/skills; o Claude usa junctions em ~/.claude/skills para a mesma cópia.
# Nada de skill fica versionado aqui: as políticas do projeto vivem em AGENTS.md,
# docs/WORKFLOW.md e docs/AMBIENTES.md, que a skill global lê ao começar.
.claude/*
.claude/settings.local.json
.claude/launch.json
.claude/scheduled_tasks.lock
.superpowers/

.DS_Store
.agents/
tmp/
